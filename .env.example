# Environment template — Peluquería Nowi
# Copy to .env.local and fill values. Leave blank until you have real credentials.
# Do not commit filled secrets.

# Runtime
NODE_ENV=development
# APP_ENV=production
# DATA_STORE must be supabase in production. memory is local/test only.
DATA_STORE=

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=

# Demo gate — set a strong secret; no default code ships in the repo
DEMO_ACCESS_CODE=
DEMO_SESSION_SECRET=
DEMO_ACCESS_RATE_LIMIT_MAX=10
DEMO_ACCESS_RATE_LIMIT_WINDOW_MS=900000

# Admin auth — create users in Supabase Auth and link staff.auth_user_id

# Cron / IP hashing
CRON_SECRET=
IP_HASH_SECRET=

# AI (production must use replicate-qwen)
AI_PROVIDER=
AI_GENERATION_ENABLED=true
AI_MAX_GENERATIONS_PER_SESSION=3
AI_MAX_GENERATIONS_PER_IP_DAY=10
AI_MAX_GENERATIONS_PER_MONTH=
AI_MAX_CONCURRENT_PER_SESSION=1
AI_ESTIMATED_COST_PER_OUTPUT_USD=0.03
REPLICATE_API_TOKEN=
REPLICATE_MODEL=qwen/qwen-image-edit-plus
REPLICATE_WEBHOOK_SECRET=

# Supabase (required for DATA_STORE=supabase and all production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_PHOTOS=photos
SUPABASE_STORAGE_BUCKET_RESULTS=results
SUPABASE_STORAGE_BUCKET_HAIRSTYLES=hairstyles

# Salon
SALON_TIMEZONE=Europe/Madrid
BOOKING_HOLD_REVIEW_HOURS=24
BOOKING_HOLD_CONFIRM_HOURS=12
DURATION_MARGIN_MINUTES=0
PRIVACY_POLICY_VERSION=2026-07-30
PHOTO_UPLOAD_ENABLED=true
